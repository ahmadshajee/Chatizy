{
  "buildCommand": "chmod +x build_web.sh && ./build_web.sh",
  "outputDirectory": "build/web",
  "installCommand": "echo 'No install needed'",
  "framework": null,
  "redirects": [
    {
      "source": "/getstarted/thankyou",
      "destination": "/thankyou",
      "permanent": true
    },
    {
      "source": "/get-started/thankyou",
      "destination": "/thankyou",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/thankyou",
      "destination": "/thankyou.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
